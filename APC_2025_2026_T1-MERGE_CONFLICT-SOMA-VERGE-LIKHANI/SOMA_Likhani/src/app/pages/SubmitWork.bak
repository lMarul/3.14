            <div className={bsolute left-[26px] top-[56px] w-16 h-16 rounded-[16px] flex items-center justify-center shrink-0 {isDark ? 'bg-[#18222B]' : 'bg-[#FFE2E2]'}}>
              <Upload className={w-8 h-8 {isDark ? 'text-[#E0202A]' : 'text-[#991B1B]'}} />
