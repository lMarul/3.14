import { FileText, UserCheck, Upload } from "lucide-react";
import { useCustomTheme } from "../components/providers/ThemeContext";
import svgPaths from "../../generated/svg-cq2lewbljb";
import { motion } from "motion/react";

export default function SubmitWork() {
  const navigate = useNavigate();
  const { theme, resolvedTheme } = useCustomTheme();
  
  const currentTheme = theme === 'system' ? resolvedTheme : theme;
  const isDim = currentTheme === 'dim';
  const isLightsOut = currentTheme === 'lights-out';
  const isDark = isDim || isLightsOut;

  return (
    <div className={min-h-screen flex flex-col font-['Poppins'] {isLightsOut ? 'bg-[#000000] text-white' : isDim ? 'bg-[#15202B] text-white' : 'bg-[#F7F6F3] text-gray-900'}}>
      <Navbar />
      
      {/* Header Banner */}
      <motion.section
        className="relative py-[70px] border-b overflow-hidden px-4 sm:px-5 md:px-6 lg:px-8 border-[#1E2939]"
        initial={{ opacity: 0, y: 14, scale: 0.99 }}
        animate={{ opacity: 1, y: 0, scale: 1 }}
        transition={{ duration: 0.5, ease: "easeOut" }}
        style={{ background: isLightsOut ? '#0D0F14' : isDim ? '#131622' : '#8A181A' }}
      >
